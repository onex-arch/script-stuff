local Library = loadstring(game:HttpGet("https://raw.githubusercontent.com/sigmaboi4167-code/Linoria-Gui-Execly.gay-Gui/refs/heads/main/Linorialib", true))()
local ThemeManager = loadstring(game:HttpGet('https://raw.githubusercontent.com/violin-suzutsuki/LinoriaLib/main/addons/ThemeManager.lua'))()
local SaveManager  = loadstring(game:HttpGet('https://raw.githubusercontent.com/violin-suzutsuki/LinoriaLib/main/addons/SaveManager.lua'))()

local Window = Library:CreateWindow({
    Title = 'fast drill',
    Center = true,
    AutoShow = false,
    TabPadding = 4,
    MenuFadeTime = 0.1,
    Size = UDim2.new(0, 300, 0, 220)  -- Slightly taller to fit two tabs comfortably
})

local Tabs = {
    Main = Window:AddTab('Main'),
    Settings = Window:AddTab('Settings')
}

-- ==================== MAIN TAB (Only Fast Drill) ====================
local MainBox = Tabs.Main:AddLeftGroupbox('fast drill')

local OriginalCooldowns = {}

local function ApplyFastDrill()
    for _, v in pairs(getgc(true)) do
        if typeof(v) == "table" and rawget(v, "type") == "MiningDrill" and rawget(v, "AttackCooldown") ~= nil then
            if not OriginalCooldowns[v] then
                OriginalCooldowns[v] = v.AttackCooldown
            end
            v.AttackCooldown = 0
        end
    end
end

local function RestoreDrillCooldowns()
    for drill, original in pairs(OriginalCooldowns) do
        if drill and typeof(drill) == "table" and rawget(drill, "AttackCooldown") ~= nil then
            drill.AttackCooldown = original
        end
    end
    OriginalCooldowns = {}
end

MainBox:AddToggle('FastDrillToggle', {
    Text = 'Fast Drill',
    Default = false,
    Tooltip = 'Removes mining drill cooldown (instant mine)',
    Callback = function(Value)
        print('[cb] Fast Drill toggled:', Value)

        if Value then
            ApplyFastDrill()
            spawn(function()
                while getrenv()._G.FastDrillToggle do
                    ApplyFastDrill()
                    task.wait(1)
                end
            end)
            Library:Notify("Fast Drill enabled!", 3)
        else
            RestoreDrillCooldowns()
            Library:Notify("Fast Drill disabled.", 3)
        end
    end
})

-- Sync global toggle state
getrenv()._G.FastDrillToggle = false
Toggles.FastDrillToggle:OnChanged(function()
    getrenv()._G.FastDrillToggle = Toggles.FastDrillToggle.Value
end)

-- ==================== SETTINGS TAB (Everything else) ====================
local SettingsBox = Tabs.Settings:AddLeftGroupbox('Menu Settings')

SettingsBox:AddButton('Unload', function() 
    RestoreDrillCooldowns()
    Library:Unload() 
end)

SettingsBox:AddBlank(6)

SettingsBox:AddLabel('Menu bind'):AddKeyPicker('MenuKeybind', {
    Default = 'End',
    NoUI = true,
    Text = 'Menu keybind'
})

Library.ToggleKeybind = Options.MenuKeybind

-- Theme & Save Manager setup
ThemeManager:SetLibrary(Library)
SaveManager:SetLibrary(Library)

SaveManager:IgnoreThemeSettings()
SaveManager:SetIgnoreIndexes({ 'MenuKeybind' })

ThemeManager:SetFolder('FastDrillMenu')
SaveManager:SetFolder('FastDrillMenu/configs')

-- Apply theme and config sections to the Settings tab
ThemeManager:ApplyToTab(Tabs.Settings)
SaveManager:BuildConfigSection(Tabs.Settings)

SaveManager:LoadAutoloadConfig()

Library:Notify("Press END to open/close the menu.", 5)
