-- ==================== FAST DRILL ====================
local FastDrillBox = Tabs.Main:AddLeftGroupbox('Fast Drill')

local OriginalDrillCooldowns = {}

local function ApplyFastDrill()
    for _, v in pairs(getgc(true)) do
        if typeof(v) == "table" and rawget(v, "type") == "MiningDrill" and rawget(v, "AttackCooldown") ~= nil then
            if not OriginalDrillCooldowns[v] then
                OriginalDrillCooldowns[v] = v.AttackCooldown
            end
            v.AttackCooldown = 0
        end
    end
end

local function RestoreDrillCooldowns()
    for drill, original in pairs(OriginalDrillCooldowns) do
        if drill and typeof(drill) == "table" and rawget(drill, "AttackCooldown") ~= nil then
            drill.AttackCooldown = original
        end
    end
    OriginalDrillCooldowns = {}
end

FastDrillBox:AddToggle('FastDrillToggle', {
    Text = 'Fast Drill',
    Default = false,
    Tooltip = 'Removes mining drill cooldown (instant mine)',
    Callback = function(Value)
        if Value then
            ApplyFastDrill()
            spawn(function()
                while Toggles.FastDrillToggle.Value do
                    ApplyFastDrill()
                    task.wait(1)
                end
            end)
            Library:Notify("Fast Drill enabled!", 3)
        else
            RestoreDrillCooldowns()
            Library:Notify("Fast Drill disabled.", 3)
        end
    end
})

