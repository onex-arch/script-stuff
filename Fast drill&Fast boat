        if Toggles.FastBoatToggle.Value and (not boat or not boat.Parent) then
            findBoat()
            if boat and boat.PrimaryPart then
                applyBoatBoost()
                Library:Notify("Boat detected - Fast Boat re-enabled!", 3)
            end
        end
    end
end)

